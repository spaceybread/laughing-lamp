# Copy to demo.env (git-ignored) and fill in. Everything here is optional.
# Wi-Fi the glasses should use (e.g. your phone's hotspot). ./demo.sh joins it over USB if needed.
# On an iPhone, turn on "Maximize Compatibility" (2.4 GHz) in Personal Hotspot: that is the setting we tested with.
HOTSPOT_SSID=
HOTSPOT_PASSWORD=
# PORT=3000
# VISION_PORT=3001
